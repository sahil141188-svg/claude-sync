# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── Cron protection (set the same value in Vercel env) ────────────────────
CRON_SECRET=generate-a-long-random-string

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────
WHATSAPP_TOKEN=your-permanent-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Numbers in international format without "+", e.g. 9198XXXXXXXX
PATIENT_WHATSAPP_NUMBER=91XXXXXXXXXX
CAREGIVER_WHATSAPP_NUMBER=91XXXXXXXXXX

# ── AI provider (set one; Gemini preferred, OpenAI used as fallback) ──────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# IANA timezone used by cron jobs for "today" calculations
APP_TIMEZONE=Asia/Kolkata
