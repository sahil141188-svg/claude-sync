# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify ---
# Webhook signing secret (Settings > Notifications > Webhooks, or the custom app's API secret key)
SHOPIFY_WEBHOOK_SECRET=
# Admin API (only needed to tag COD orders "cod-confirmed")
SHOPIFY_STORE_DOMAIN=robotek1.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
# ...or, for an app made in the Shopify Dev Dashboard and installed on the store:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-07

# --- Which WhatsApp sender: "meta" (WhatsApp Cloud API, default) or "maytapi" ---
WA_PROVIDER=meta

# --- Maytapi (only when WA_PROVIDER=maytapi) ---
MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_API_TOKEN=
# Any long random string; add it to the webhook URL as ?key=...
MAYTAPI_WEBHOOK_SECRET=
# Optional: your previous Maytapi webhook URL; every event is forwarded there too
MAYTAPI_FORWARD_URL=

# --- WhatsApp Cloud API (only when WA_PROVIDER=meta) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=choose-any-long-random-string
# Optional but recommended: Meta app secret, used to verify X-Hub-Signature-256 on incoming webhooks
WA_APP_SECRET=
WA_TEMPLATE_LANG=en
WA_GRAPH_VERSION=v21.0
# Nothing is sent to WhatsApp until this is exactly "true". Otherwise messages are logged only.
WA_LIVE=false

# --- Messages ---
# Link used as {{3}} in review_request. {order_no} is replaced with the order number.
REVIEW_URL=https://robotekindia.com/pages/reviews?order={order_no}
# Used for "Expected delivery by" when the courier gives no estimate
DEFAULT_DELIVERY_DAYS=5

# --- Cron ---
CRON_SECRET=choose-any-long-random-string
